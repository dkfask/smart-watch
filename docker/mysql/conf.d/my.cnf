# MySQL configuration overrides for the Smart Watch container.
# Mounted at /etc/mysql/conf.d/ inside the official mysql:8.0 image.
#
# Notes:
# - event_scheduler is enabled here (rather than via `SET GLOBAL` in an init
#   SQL) because the official MySQL image refuses `SET GLOBAL` from init
#   scripts depending on user/permissions, while conf.d is always applied.
# - default-time-zone matches the application TZ (Asia/Shanghai, +08:00).

[mysqld]
event_scheduler = ON
default-time-zone = +08:00
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
