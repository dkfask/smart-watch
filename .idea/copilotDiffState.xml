  if (!s) return ''&#10;      try { return new Date(s).toLocaleString() } catch(e){ return s }&#10;    }&#10;  },&#10;  mounted() {&#10;    this.reload()&#10;  }&#10;}&#10;&lt;/script&gt;&#10;&#10;&lt;!-- 使用全局样式：.card / .input-row / .btn / .table 等 --&gt;" />
