       console.error('获取设备失败', e)&#10;        alert('获取设备失败')&#10;      }&#10;    },&#10;    formatDate(s) { if (!s) return ''; try { return new Date(s).toLocaleString() } catch(e){ return s } }&#10;  },&#10;  mounted() { this.load() }&#10;}&#10;&lt;/script&gt;" />
