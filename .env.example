# Smart Watch 系统环境变量配置模板
# 复制此文件为 .env 并填入实际值

# 数据库配置
DB_URL=jdbc:mysql://localhost:3306/smart_watch?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# 天地图 API Key (Token) - 用于前端 Leaflet 底图渲染与后端逆地理编码
TIANDITU_KEY=your_tianditu_key

# 设备通信响应 Key
MPBAND_RESPONSE_KEY=your_mpband_response_key

# AI 助手（OpenAI 兼容接口，默认 DeepSeek；留空 AI_API_KEY 则 AI 功能停用）
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=your_ai_api_key
AI_MODEL=deepseek-chat
