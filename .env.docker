# ============================================================================
# Smart Watch Monitoring System — Docker environment template
# ============================================================================
# Copy to `.env` and edit the values before running `docker compose up -d`.
# The real `.env` is git-ignored; this template IS committed.
# ============================================================================

# ---- MySQL -----------------------------------------------------------------
# Strong defaults; change before exposing MySQL outside localhost.
MYSQL_ROOT_PASSWORD=rootpass_change_me
MYSQL_DATABASE=smart_watch
MYSQL_USER=smart_user
MYSQL_PASSWORD=smart123

# Host port that MySQL listens on. Change if 3306 is taken on the host.
MYSQL_HOST_PORT=3306

# ---- Application -----------------------------------------------------------
# Host port mappings. Change these if you have local services on 8080/9000.
APP_HTTP_PORT=8080
APP_MPBAND_PORT=9000
APP_TCP_PORT=9090

# ---- Third-party / device secrets ------------------------------------------
# High德 (Amap) web API key for map tiles and address resolution.
AMAP_WEB_KEY=

# Response key shared with the bracelet firmware (BP protocol).
MPBAND_RESPONSE_KEY=
