<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 渐变头部区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_header"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <!-- 问候行 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/layout_greeting"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/layout_header_actions">

                        <TextView
                            android:id="@+id/tv_greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/white"
                            android:alpha="0.8"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <!-- 通知铃铛 + 头像 -->
                    <LinearLayout
                        android:id="@+id/layout_header_actions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <FrameLayout
                            android:id="@+id/btn_notification"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_nav_alarm"
                                app:tint="@color/white" />

                            <View
                                android:id="@+id/view_unread_badge"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="6dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_status_dot"
                                android:visibility="gone" />

                        </FrameLayout>

                        <ImageView
                            android:id="@+id/iv_user_avatar"
                            android:layout_width="@dimen/avatar_size_small"
                            android:layout_height="@dimen/avatar_size_small"
                            android:src="@drawable/ic_person_avatar" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 统计卡片 2x2 Grid -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:useDefaultMargins="true">

                    <!-- 病人总数卡片 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_patient_count"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/stat_card_height"
                        android:layout_columnWeight="1"
                        app:cardCornerRadius="@dimen/card_corner_radius_large"
                        app:cardElevation="4dp"
                        app:cardPreventCornerOverlap="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_stat_card_blue"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_nav_patient"
                                app:tint="@color/white"
                                android:alpha="0.85" />

                            <TextView
                                android:id="@+id/tv_patient_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.SmartWatchMonitor.StatValue" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/patient_count_label"
                                android:textAppearance="@style/TextAppearance.SmartWatchMonitor.StatLabel" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- 设备总数卡片 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_device_count"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/stat_card_height"
                        android:layout_columnWeight="1"
                        app:cardCornerRadius="@dimen/card_corner_radius_large"
                        app:cardElevation="4dp"
                        app:cardPreventCornerOverlap="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_stat_card_green"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_nav_device"
                                app:tint="@color/white"
                                android:alpha="0.85" />

                            <TextView
                                android:id="@+id/tv_device_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.SmartWatchMonitor.StatValue" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/tv_device_online"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="10sp"
                                    android:textColor="@color/white"
                                    android:alpha="0.85" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- 活跃围栏卡片 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_fence_count"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/stat_card_height"
                        android:layout_columnWeight="1"
                        app:cardCornerRadius="@dimen/card_corner_radius_large"
                        app:cardElevation="4dp"
                        app:cardPreventCornerOverlap="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_stat_card_amber"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_nav_fence"
                                app:tint="@color/white"
                                android:alpha="0.85" />

                            <TextView
                                android:id="@+id/tv_fence_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.SmartWatchMonitor.StatValue" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/fence_count_label"
                                android:textAppearance="@style/TextAppearance.SmartWatchMonitor.StatLabel" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- 未处理报警卡片 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_pending_alarms"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/stat_card_height"
                        android:layout_columnWeight="1"
                        app:cardCornerRadius="@dimen/card_corner_radius_large"
                        app:cardElevation="4dp"
                        app:cardPreventCornerOverlap="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_stat_card_red"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_nav_alarm"
                                app:tint="@color/white"
                                android:alpha="0.85" />

                            <TextView
                                android:id="@+id/tv_pending_alarms"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.SmartWatchMonitor.StatValue" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pending_alarms_label"
                                android:textAppearance="@style/TextAppearance.SmartWatchMonitor.StatLabel" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </GridLayout>

            </LinearLayout>

            <!-- 下方内容区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="-8dp">

                <!-- 报警统计环形图 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_alarm_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/alarm_stats_chart"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/chart_alarm_stats"
                            android:layout_width="@dimen/pie_chart_size"
                            android:layout_height="@dimen/pie_chart_size"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="12dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 快捷操作区 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quick_actions"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_locate_all"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_locate_all"
                            app:chipIcon="@drawable/ic_nav_device"
                            app:chipIconVisible="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_heart_rate"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_heart_rate_measure"
                            app:chipIcon="@drawable/ic_favorite"
                            app:chipIconVisible="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_sos"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_sos_handle"
                            app:chipIcon="@drawable/ic_nav_alarm"
                            app:chipIconVisible="true" />

                    </com.google.android.material.chip.ChipGroup>

                </HorizontalScrollView>

                <!-- 最近报警标题行 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tv_recent_alarms_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recent_alarms_label"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tv_view_all_alarms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/view_all_alarms"
                        android:textSize="13sp"
                        android:textColor="@color/primary_blue"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 最近报警列表 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_recent_alarms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- 空状态 -->
                <LinearLayout
                    android:id="@+id/layout_empty_alarms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_no_data"
                        android:alpha="0.5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_alarm"
                        android:textSize="14sp"
                        android:textColor="@color/text_hint"
                        android:layout_marginTop="12dp" />

                </LinearLayout>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginTop="32dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
