<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- 健康指标卡片 2x2 -->
            <GridLayout
                android:id="@+id/grid_health_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:useDefaultMargins="true">

                <!-- 心率卡片 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_heart_rate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation"
                    app:strokeColor="#EF4444"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_favorite"
                            android:contentDescription="@string/health_heart_rate"
                            app:tint="#EF4444" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/health_heart_rate"
                            android:textSize="12sp"
                            android:textColor="#EF4444"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tv_heart_rate_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#EF4444"
                            android:layout_marginTop="2dp" />

                        <!-- 迷你趋势线 -->
                        <com.smartwatch.monitor.ui.widget.MiniSparklineView
                            android:id="@+id/sparkline_heart_rate"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/mini_chart_height"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/health_normal_range_hr"
                            android:textSize="10sp"
                            android:textColor="@color/text_hint"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tv_heart_rate_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 体温卡片 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_temperature"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation"
                    app:strokeColor="#F59E0B"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_thermometer"
                            android:contentDescription="@string/health_temperature"
                            app:tint="#F59E0B" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/health_temperature"
                            android:textSize="12sp"
                            android:textColor="#F59E0B"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tv_temperature_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#F59E0B"
                            android:layout_marginTop="2dp" />

                        <com.smartwatch.monitor.ui.widget.MiniSparklineView
                            android:id="@+id/sparkline_temperature"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/mini_chart_height"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/health_normal_range_temp"
                            android:textSize="10sp"
                            android:textColor="@color/text_hint"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tv_temperature_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 血压卡片 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_blood_pressure"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation"
                    app:strokeColor="#8B5CF6"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_water_drop"
                            android:contentDescription="@string/health_blood_pressure"
                            app:tint="#8B5CF6" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/health_blood_pressure"
                            android:textSize="12sp"
                            android:textColor="#8B5CF6"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tv_blood_pressure_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#8B5CF6"
                            android:layout_marginTop="2dp" />

                        <com.smartwatch.monitor.ui.widget.MiniSparklineView
                            android:id="@+id/sparkline_blood_pressure"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/mini_chart_height"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/health_normal_range_bp"
                            android:textSize="10sp"
                            android:textColor="@color/text_hint"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tv_blood_pressure_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 血氧卡片 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_spo2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation"
                    app:strokeColor="#3B82F6"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_air"
                            android:contentDescription="@string/health_spo2"
                            app:tint="#3B82F6" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/health_spo2"
                            android:textSize="12sp"
                            android:textColor="#3B82F6"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tv_spo2_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#3B82F6"
                            android:layout_marginTop="2dp" />

                        <com.smartwatch.monitor.ui.widget.MiniSparklineView
                            android:id="@+id/sparkline_spo2"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/mini_chart_height"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/health_normal_range_spo2"
                            android:textSize="10sp"
                            android:textColor="@color/text_hint"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tv_spo2_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- 时间范围选择器 -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_data_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:tabMode="fixed"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/primary_blue"
                app:tabSelectedTextColor="@color/primary_blue"
                app:tabTextAppearance="@style/TextAppearance.MaterialComponents.Body2" />

            <!-- 时间范围 Chips -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_time_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true"
                app:chipSpacingHorizontal="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_7d"
                    style="@style/Widget.SmartWatchMonitor.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_range_7d"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_30d"
                    style="@style/Widget.SmartWatchMonitor.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_range_30d" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_90d"
                    style="@style/Widget.SmartWatchMonitor.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_range_90d" />

            </com.google.android.material.chip.ChipGroup>

            <!-- 趋势图 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/health_trend_chart"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chart_health"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/chart_height"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
